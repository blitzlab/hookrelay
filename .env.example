DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=hookrelay
POSTGRES_USER=hookrelay
POSTGRES_PASSWORD=hookrelay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1

# Empty disables auth for local development.
HOOKRELAY_API_KEY=
HOOKRELAY_MAX_ATTEMPTS=8
HOOKRELAY_BACKOFF_BASE_SECONDS=2
HOOKRELAY_BACKOFF_CAP_SECONDS=3600
HOOKRELAY_REQUEST_TIMEOUT_SECONDS=10
HOOKRELAY_BREAKER_FAILURE_THRESHOLD=5
HOOKRELAY_BREAKER_COOLDOWN_SECONDS=30
# The demo receiver runs on the private Docker network.
HOOKRELAY_ALLOW_PRIVATE_URLS=true
